<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: allow plain HTTP so `flutter run` can load a local
     gateway such as http://10.0.2.2:8080. Release builds never see this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
