{
 "what": "MiniPlay load profile through the gateway on a disposable local stack, a shared rate-limit bucket found and fixed, and an A/B of publishing board updates only on change",
 "date": "2026-10-22",
 "hardware": "Apple M3 Pro (11 cores), 18 GiB memory, macOS 15.3.1; services ran natively, Redis and Kafka in Docker Desktop",
 "versions": {
  "go": "1.27.2 (project .toolchain)",
  "postgresql": "18.6 (Homebrew binaries, disposable cluster on 127.0.0.1:55432)",
  "redis": "7.4.11 container on 127.0.0.1:16379",
  "kafka": "apache/kafka 3.9.1 single-node KRaft container on 127.0.0.1:19092, topics score.events and score.deadletter (3 partitions)"
 },
 "stack": "migrate, session-svc :18081, score-svc :18082, leaderboard-svc :18083, gateway :18080, outbox-publisher and stats-worker, built from the working tree; a new per-run HMAC secret that was not recorded. Every step started from a new PostgreSQL cluster and new Redis and Kafka containers, removed afterwards.",
 "probe": {
  "tool": "cmd/load-probe, run natively on the same Mac",
  "per_run": "open the player's live board socket, POST /api/sessions, wait 10.2 s (the real game window), POST /api/scores with 12 replayed hits, then time from the score submission to the first frame carrying the player's rank",
  "background": "50 idle live-board sockets for the whole step and 10 GET /api/leaderboards a second",
  "clients": "each run uses its own user and its own synthetic client address from 198.18.0.0/15 in X-Forwarded-For; the services believe it only because the probe and gateway connect from loopback, which is a trusted proxy range",
  "duration": "new runs start at a fixed rate for 60 s; each step then waits for the last runs to finish",
  "cpu": "ps sampled every 2 s for each service process"
 },
 "limit_check_smoke": {
  "what": "40 session starts from one synthetic client through the gateway, after the fix",
  "status_counts": {
   "200": 30,
   "429": 10
  },
  "meaning": "the per-client burst of 30 still applies to one client"
 },
 "findings": {
  "shared_rate_limit_bucket": {
   "problem": "The session and score services keyed their per-IP limits on RemoteAddr. Behind the gateway (httputil.NewSingleHostReverseProxy) every request arrives from the gateway's loopback address, so all players shared one bucket: a burst of 30 session starts, then 0.5 a second for everyone together.",
   "fix": "internal/httpapi/clientip.go: when the direct peer is a trusted proxy (MINIPLAY_TRUSTED_PROXIES, default 127.0.0.0/8 and ::1), read X-Forwarded-For from the right, skip trusted hops and use the first untrusted address; a direct untrusted peer is used as is and its header ignored.",
   "test": "TestSessionLimitKeysOnClientBehindGatewayProxy sends two clients through the real reverse proxy; on the old code both were keyed session-ip:127.0.0.1, now each has its own key."
  },
  "double_publish": {
   "problem": "Both score-svc and stats-worker call UpdateBoards for every accepted score, and the Lua script published a notification each time, even when ZADD GT changed nothing. Each notification makes every live socket on that board rebuild a frame (Redis read, rank lookup, completeness check), which is the work that grows with sockets times updates.",
   "fix": "ZADD GT CH returns how many members changed; the script publishes only when that is above zero. A replay or a lower score no longer wakes sockets; a new key, a higher score or a repair after Redis loss still does.",
   "test": "TestRedisBoardPublishesOnlyChangesIntegration (opt-in, Redis DB 15): new, replay, lower, higher published 4 notifications with the old script and 2 with the new one."
  }
 },
